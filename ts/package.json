{
  "name": "@aiviarium/sparrow",
  "version": "0.1.0",
  "description": "Sparrow for TypeScript: CBOR, wire format, schemas, schema-driven values, sessions, and the pipe, WebSocket and in-memory bindings.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pipe": {
      "types": "./dist/transport/pipe.d.ts",
      "default": "./dist/transport/pipe.js"
    },
    "./websocket": {
      "types": "./dist/transport/websocket.d.ts",
      "default": "./dist/transport/websocket.js"
    },
    "./webtransport": {
      "types": "./dist/transport/webtransport.d.ts",
      "default": "./dist/transport/webtransport.js"
    },
    "./mem": {
      "types": "./dist/transport/mem.d.ts",
      "default": "./dist/transport/mem.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "cbor2": "^2.4.2",
    "typescript": "~5.9",
    "vitest": "^3.2.7",
    "ws": "^8.23.1"
  }
}
